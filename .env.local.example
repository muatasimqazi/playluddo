# Copy to .env.local and fill in from `supabase status` (local) or the Supabase dashboard (staging/prod).
# Both are safe to expose to the browser — see docs/IMPLEMENTATION_HANDOFF.md Section 1.
# No service-role key is used anywhere in this app: all writes go through SECURITY DEFINER
# RPC functions called under the signed-in user's own session (docs/PRD.md Section 6.2).

NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). NEXT_PUBLIC_SUPABASE_ANON_KEY is
# still read as a fallback by lib/supabase/client.ts and the integration tests.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog project API key + host, from the PostHog project settings. Safe to
# expose to the browser — it's a write-only token used to send events.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Web Push (F1.7): the VAPID public key browsers subscribe with. Safe to
# expose. Generate a pair with `npx tsx scripts/generate-vapid-keys.ts`; the
# private half is a push-dispatch function secret, never an env var here.
# Leave empty and the web app simply doesn't offer notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
