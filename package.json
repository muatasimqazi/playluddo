{
  "name": "luddo-house",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "Lowers Next's default Chrome 111 floor to Chrome 79 so the bundle parses on LG webOS TV browsers (NetCast, Chromium 79). The oldest listed browser drives SWC down-leveling of modern syntax (class static blocks, optional chaining, nullish, logical assignment). Runtime-only APIs newer than Chrome 79 still need explicit polyfills.",
  "browserslist": [
    "chrome 79",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:capacitor": "CAPACITOR_BUILD=1 next build",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "ios": "npm run cap:sync && npx cap open ios",
    "ios:archive": "bash scripts/ios-archive.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/rules-engine-ts tests/presentation tests/i18n",
    "test:watch": "vitest tests/rules-engine-ts",
    "test:parity": "vitest run tests/parity",
    "test:multiplayer": "vitest run tests/integration",
    "test:strength": "vitest run tests/strength",
    "board:hex": "tsx scripts/generate-hex-board.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^13.3.0",
    "next": "16.3.5",
    "posthog-js": "^1.434.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
