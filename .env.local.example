# Copy to .env.local and fill in from `supabase status` (local) or the Supabase dashboard (staging/prod).
# Both are safe to expose to the browser — see docs/IMPLEMENTATION_HANDOFF.md Section 1.
# No service-role key is used anywhere in this app: all writes go through SECURITY DEFINER
# RPC functions called under the signed-in user's own session (docs/PRD.md Section 6.2).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
